# Dev-only defaults for docker-compose.yml. Copy to .env (git-ignored) and
# change only what you need; any variable left out uses the default shown here.

# PostgreSQL
POSTGRES_DB=csms
POSTGRES_USER=csms
POSTGRES_PASSWORD=csms_dev
POSTGRES_PORT=5432

# Seq: UI/API port, ingestion-only port, and whether to skip login.
# SEQ_NO_AUTH is read on first start only; to change it later, remove the seq-data volume.
SEQ_UI_PORT=5380
SEQ_INGEST_PORT=5341
SEQ_NO_AUTH=true

# Jaeger: UI port and OTLP receiver ports (gRPC, HTTP)
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
